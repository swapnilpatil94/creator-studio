node_modules/
*.log
.DS_Store

# Raw reference videos are kept locally for analysis only (see
# reference-analysis/REFERENCE_PROFILE.md "Important finding about the source file") and must
# not be committed or distributed.
reference-analysis/sources/
stories/*/output/
stories/*/build/
projects/
audio/cache/
.env.local
.yt-token.json
stories/*/.thumb-scene.js
stories/*/assets/original/
research/corpus/
research/index.json
flux-out/
blog/dist/
site/dist/
site/.astro/
content/out/

# Regenerable render intermediates: camera-move frame sequences (tools/layers/camera-clips.mjs)
# and depth/parallax layer assets (tools/layers/layers.mjs, mesh_* camera effects) -- both are
# deterministically rebuilt from the story's own art, so tracking them only bloats the repo.
stories/*/clips/
stories/*/assets/layers/
.cache/
scratch/
stories/*/narration/voice/pre_post.wav
content/art/*/prompts.json.bak
stories/reel-*/assets/*.stip
stories/reel-*/narration/voice/*.wav

# outlier engine output lives on the `data` branch, not main
planner/data/monthly/
planner/data/outliers-monthly-*
planner/data/outliers-kathaaya-*
audio/.venv-veena/

# recorded music beds (46 MB) are rebuilt by tools/sound/fetch-music.py; the licence ledger stays in git
assets/sound/music/*.m4a
assets/lora/*.safetensors

# Reel Factory heavy output
reel-factory/episodes/*
!reel-factory/episodes/.gitkeep
reel-factory/.cache/
reel-factory/node_modules/
reel-factory/assets/cache/
reel-factory/.venv/
stories/rf-*/
