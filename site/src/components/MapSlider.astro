---
// "Then vs Now" comparison slider: pure CSS clip + pointer events, no library. Works with touch (drag), mouse and keyboard (the range input).
interface Props { beforeImage: string; afterImage: string; beforeLabel?: string; afterLabel?: string; alt?: string; caption?: string; }
const { beforeImage, afterImage, beforeLabel = "तब · THEN", afterLabel = "अब · NOW", alt = "प्राचीन और आधुनिक मानचित्र की तुलना", caption } = Astro.props;
---
<figure class="mapslider my-10" data-slider>
  <div class="relative aspect-[16/10] w-full select-none overflow-hidden rounded-2xl border border-[var(--line)] shadow-[var(--shadow)] touch-pan-y" style="--pos:50%">
    <img src={beforeImage} alt={alt + " (पहले)"} class="absolute inset-0 h-full w-full object-cover" loading="lazy" draggable="false" />
    <img src={afterImage} alt={alt + " (अब)"} class="absolute inset-0 h-full w-full object-cover" style="clip-path: inset(0 0 0 var(--pos))" loading="lazy" draggable="false" />
    <span class="chip absolute left-3 top-3 !bg-black/55 !text-white backdrop-blur">{beforeLabel}</span>
    <span class="chip absolute right-3 top-3 !bg-black/55 !text-white backdrop-blur">{afterLabel}</span>
    <div class="handle pointer-events-none absolute inset-y-0 w-0.5 bg-white/90 shadow-[0_0_14px_rgba(0,0,0,.6)]" style="left: var(--pos)">
      <div class="absolute left-1/2 top-1/2 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-black/55 text-white backdrop-blur"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"/></svg></div>
    </div>
    <input type="range" min="0" max="100" value="50" aria-label="तुलना स्लाइडर" class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-[var(--muted)]">{caption}</figcaption>}
</figure>
<script>
  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((fig) => {
    const box = fig.firstElementChild as HTMLElement, input = box.querySelector("input")!;
    const set = (v: number) => { v = Math.max(0, Math.min(100, v)); box.style.setProperty("--pos", v + "%"); input.value = String(v); };
    input.addEventListener("input", () => set(Number(input.value)));
    const fromPointer = (e: PointerEvent) => { const r = box.getBoundingClientRect(); set(((e.clientX - r.left) / r.width) * 100); };
    box.addEventListener("pointerdown", (e) => { box.setPointerCapture(e.pointerId); fromPointer(e); });
    box.addEventListener("pointermove", (e) => { if (box.hasPointerCapture(e.pointerId)) fromPointer(e); });
  });
</script>
