---
// Injects NewsArticle (+ BreadcrumbList) JSON-LD built from the post's frontmatter. Usage: <NewsSchema post={post.data} url={Astro.url.href} image={absoluteImageUrl} />
import type { PostFrontmatter } from "../content.config";
import { LOCALES } from "../i18n/config";
interface Props { post: PostFrontmatter; url: string; image?: string; siteName?: string; logo?: string; lang?: string; }
const { post, url, image, lang = "hi", siteName = "कथाया (KATHAAYA)", logo = new URL("/logo.png", Astro.site).href } = Astro.props;
const sections: Record<string, string> = { itihasa: "इतिहास", puranas: "पुराण", "vrat-tyohar": "व्रत और त्योहार", world: "विश्व पुराकथाएँ" };
const iso = (d?: Date) => (d ? d.toISOString() : undefined);
const news = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  headline: [...post.title].slice(0, 110).join(""),
  description: post.description,
  inLanguage: LOCALES[lang]?.bcp ?? "hi-IN",
  datePublished: iso(post.publishDate),
  dateModified: iso(post.updatedDate ?? post.publishDate),
  author: { "@type": "Organization", name: post.author, url: new URL("/about/", Astro.site).href },
  publisher: { "@type": "Organization", name: siteName, logo: { "@type": "ImageObject", url: logo, width: 512, height: 512 } },
  isAccessibleForFree: true,
  articleSection: sections[post.section] ?? post.section,
  keywords: [...post.hinglishKeywords, ...(post.trendingEventConnection ? [post.trendingEventConnection] : [])].join(", "),
  ...(post.trendingEventConnection ? { about: { "@type": "Thing", name: post.trendingEventConnection } } : {}),
  ...(image || post.images.length ? { image: [...(image ? [image] : []), ...post.images.filter((i) => i.role !== "hero").map((i) => new URL(i.src, Astro.site).href)] } : {}),
  ...(post.sources.length ? { citation: post.sources } : {}),
};
// the embedded YouTube video as VideoObject (helps the video appear in Search and Discover; the thumbnail is YouTube's own)
const video = post.videoId ? { "@context": "https://schema.org", "@type": "VideoObject", name: post.title, description: post.description, thumbnailUrl: [`https://i.ytimg.com/vi/${post.videoId}/hqdefault.jpg`], uploadDate: iso(post.publishDate), embedUrl: `https://www.youtube.com/embed/${post.videoId}`, inLanguage: LOCALES[lang]?.bcp ?? "hi-IN" } : null;
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "मुख्य पृष्ठ", item: new URL("/", Astro.site).href },
  { "@type": "ListItem", position: 2, name: sections[post.section] ?? post.section, item: new URL(`/category/${post.section}/`, Astro.site).href },
  { "@type": "ListItem", position: 3, name: post.title, item: url } ] };
---
<script type="application/ld+json" set:html={JSON.stringify(news)} />
<script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
{video && <script type="application/ld+json" set:html={JSON.stringify(video)} />}
