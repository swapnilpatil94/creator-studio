---
import "../styles/global.css";
import "@fontsource/rozha-one/400.css";
import "@fontsource/noto-sans-devanagari/400.css";
import "@fontsource/noto-sans-devanagari/700.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/600.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import Logo from "../components/Logo.astro";
import LangSwitch from "../components/LangSwitch.astro";
import { SECTION_KEYS, section } from "../lib/posts";
import { LOCALES, DEFAULT_LANG, langPath } from "../i18n/config";
import { useT } from "../i18n/ui";
interface Props { title: string; description: string; image?: string; type?: "website" | "article"; noindex?: boolean; lang?: string; alternates?: Record<string, string> }
const { title, description, image, type = "website", noindex = false, lang = DEFAULT_LANG, alternates = {} } = Astro.props, t = useT(lang), L = (p: string) => langPath(lang, p), loc = LOCALES[lang];
const hreflangs = Object.entries(alternates);
const canonical = new URL(Astro.url.pathname, Astro.site).href, og = image ? new URL(image, Astro.site).href : new URL("/og-default.jpg", Astro.site).href;
const full = title.includes("KATHAAYA") ? title : `${title} | KATHAAYA`;
---
<!doctype html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  {hreflangs.map(([l, href]) => <link rel="alternate" hreflang={LOCALES[l].bcp} href={new URL(href, Astro.site).href} />)}
  {hreflangs.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LANG] ?? Object.values(alternates)[0], Astro.site).href} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content={type} /><meta property="og:url" content={canonical} /><meta property="og:image" content={og} /><meta property="og:locale" content={loc.og} /><meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="alternate" type="application/rss+xml" title="KATHAAYA" href={L("/rss.xml")} /><meta name="theme-color" content="#080710" />
  <script is:inline>try{var t=localStorage.getItem("theme")||(matchMedia("(prefers-color-scheme: light)").matches?"light":"dark");document.documentElement.dataset.theme=t}catch(e){}</script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{t("skip")}</a>
  <header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[color-mix(in_srgb,var(--bg)_72%,transparent)] backdrop-blur-xl">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <a href={L("/")} class="flex items-center gap-3" aria-label={"KATHAAYA " + t("home")}><Logo /><span class="font-latin text-sm font-semibold tracking-[.32em] gold-text">KATHAAYA</span></a>
      <nav class="hidden items-center gap-6 text-[.95rem] md:flex" aria-label="menu">
        {SECTION_KEYS.map((k) => <a href={L(`/category/${k}/`)} class="hover:text-[var(--gold)] transition">{section(lang, k).name}</a>)}
        <a href="/about/" class="hover:text-[var(--gold)] transition">{t("about")}</a>
      </nav>
      <div class="flex items-center gap-2"><LangSwitch current={lang} alternates={alternates} /><ThemeToggle /></div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="mt-24 border-t border-[var(--line)]">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div><div class="flex items-center gap-3"><Logo size={40} /><span class="font-display text-2xl gold-text">{t("siteName")}</span></div><p class="mt-3 max-w-sm text-[var(--muted)]">{t("footerAbout")}</p></div>
      <nav aria-label="topics"><div class="chip mb-3">{t("topics")}</div><ul class="space-y-1">{SECTION_KEYS.map((k) => <li><a class="hover:text-[var(--gold)]" href={L(`/category/${k}/`)}>{section(lang, k).name}</a></li>)}</ul></nav>
      <nav aria-label="policies"><div class="chip mb-3">{t("transparency")}</div><ul class="space-y-1"><li><a class="hover:text-[var(--gold)]" href="/about/">{t("about")}</a></li><li><a class="hover:text-[var(--gold)]" href="/editorial-policy/">{t("policy")}</a></li><li><a class="hover:text-[var(--gold)]" href="/corrections/">{t("corrections")}</a></li><li><a class="hover:text-[var(--gold)]" href="/privacy/">{t("privacy")}</a></li><li><a class="hover:text-[var(--gold)]" href="/contact/">{t("contact")}</a></li></ul></nav>
    </div>
    <div class="rule-gold"></div>
    <p class="mx-auto max-w-6xl px-4 py-5 text-center text-xs text-[var(--muted)]">{t("footerLegal")}</p>
  </footer>
</body>
</html>
