---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPublished, SECTIONS } from "../lib/posts";
const posts = await getPublished(), [lead, ...rest] = posts;
---
<Base title="कथाया: भारतीय कथाएँ, स्रोत के साथ" description="महाभारत, रामायण और पुराणों की कथाएँ, हर लेख में स्रोत और भिन्न मतों के साथ। चित्र, इन्फोग्राफ़िक, वीडियो और प्रश्नोत्तरी।">
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 text-center sm:pt-24">
      <div class="chip reveal">THE STORY OF EVERY KATHA, WITH ITS SOURCE</div>
      <h1 class="reveal mx-auto mt-6 max-w-4xl font-display text-[clamp(2.4rem,1.2rem+5.4vw,5.2rem)] leading-[1.25] gold-text" style="animation-delay:.1s">हर कथा, उसके स्रोत के साथ</h1>
      <p class="reveal p-hi mx-auto mt-5 max-w-2xl text-[var(--muted)]" style="animation-delay:.25s">वो हिस्से जो धारावाहिक छोड़ देते हैं: ग्रंथ में क्या लिखा है, और परंपराएँ कहाँ अलग कहती हैं।</p>
      <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-3" style="animation-delay:.4s"><a href="#latest" class="btn">ताज़ा कथाएँ पढ़िए</a><a href="/editorial-policy/" class="btn btn-ghost">हम कैसे लिखते हैं</a></div>
    </div>
    <div class="rule-gold"></div>
  </section>
  <section id="latest" class="mx-auto max-w-6xl px-4 pt-14">
    <div class="mb-6 flex items-end justify-between"><h2 class="h2-hi !m-0">ताज़ा कथाएँ <span class="font-latin text-xs tracking-[.3em] text-[var(--gold)]">LATEST</span></h2></div>
    {lead ? <PostCard post={lead} big /> : <p class="glass p-8 text-center text-[var(--muted)]">पहली कथा जल्द ही यहाँ आएगी।</p>}
    {rest.length > 0 && <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{rest.map((p) => <PostCard post={p} />)}</div>}
  </section>
  <section class="mx-auto mt-20 max-w-6xl px-4">
    <h2 class="h2-hi">विषय <span class="font-latin text-xs tracking-[.3em] text-[var(--gold)]">EXPLORE</span></h2>
    <div class="mt-5 grid gap-5 md:grid-cols-3">
      {Object.entries(SECTIONS).map(([k, s]) => <a href={`/category/${k}/`} class="glass glass-lift p-7"><div class="font-latin text-xs tracking-[.3em] text-[var(--gold)]">{s.en}</div><div class="h-hi mt-2 text-[1.7rem]">{s.hi}</div><p class="mt-2 text-[var(--muted)]">{s.blurb}</p></a>)}
    </div>
  </section>
</Base>
