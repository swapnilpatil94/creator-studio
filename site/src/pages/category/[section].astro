---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublished, SECTIONS } from "../../lib/posts";
export function getStaticPaths() { return Object.keys(SECTIONS).map((section) => ({ params: { section } })); }
const { section } = Astro.params, s = SECTIONS[section!], posts = (await getPublished()).filter((p) => p.data.section === section);
---
<Base title={`${s.hi}: कथाएँ`} description={s.blurb}>
  <div class="mx-auto max-w-6xl px-4 pt-14"><h1 class="dual"><span class="hi gold-text">{s.hi}</span><span class="en">{s.en}</span></h1><p class="p-hi mt-3 text-[var(--muted)]">{s.blurb}</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{posts.map((p) => <PostCard post={p} />)}</div>
    {posts.length === 0 && <p class="glass mt-8 p-8 text-center text-[var(--muted)]">इस विषय की कथाएँ जल्द आएँगी।</p>}</div>
</Base>
