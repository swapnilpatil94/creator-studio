---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublished, liveLangs, SECTION_KEYS, section } from "../../lib/posts";
import { DEFAULT_LANG, langPath } from "../../i18n/config";
import { useT } from "../../i18n/ui";
export async function getStaticPaths() { return (await liveLangs()).map((l) => ({ params: { lang: l === DEFAULT_LANG ? undefined : l }, props: { lang: l } })); }
const { lang } = Astro.props, t = useT(lang), L = (p: string) => langPath(lang, p), live = await liveLangs(), alternates = Object.fromEntries(live.map((l) => [l, langPath(l, "/")]));
const posts = await getPublished(lang), [lead, ...rest] = posts;
---
<Base lang={lang} alternates={alternates} title={t("indexTitle")} description={t("indexDesc")}>
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 text-center sm:pt-24">
      <div class="chip reveal">{t("heroKicker")}</div>
      <h1 class="reveal mx-auto mt-6 max-w-4xl font-display text-[clamp(2.4rem,1.2rem+5.4vw,5.2rem)] leading-[1.25] gold-text" style="animation-delay:.1s">{t("heroTitle")}</h1>
      <p class="reveal p-hi mx-auto mt-5 max-w-2xl text-[var(--muted)]" style="animation-delay:.25s">{t("heroLead")}</p>
      <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-3" style="animation-delay:.4s"><a href="#latest" class="btn">{t("readLatest")}</a><a href="/editorial-policy/" class="btn btn-ghost">{t("howWeWrite")}</a></div>
    </div>
    <div class="rule-gold"></div>
  </section>
  <section id="latest" class="mx-auto max-w-6xl px-4 pt-14">
    <div class="mb-6 flex items-end justify-between"><h2 class="h2-hi !m-0">{t("latest")} <span class="font-latin text-xs tracking-[.3em] text-[var(--gold)]">LATEST</span></h2></div>
    {lead ? <PostCard post={lead} lang={lang} big /> : <p class="glass p-8 text-center text-[var(--muted)]">{t("firstSoon")}</p>}
    {rest.length > 0 && <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{rest.map((p) => <PostCard post={p} lang={lang} />)}</div>}
  </section>
  <section class="mx-auto mt-20 max-w-6xl px-4">
    <h2 class="h2-hi">{t("topics")} <span class="font-latin text-xs tracking-[.3em] text-[var(--gold)]">EXPLORE</span></h2>
    <div class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {SECTION_KEYS.map((k) => { const s = section(lang, k); return <a href={L(`/category/${k}/`)} class="glass glass-lift p-7"><div class="font-latin text-xs tracking-[.3em] text-[var(--gold)]">{s.en}</div><div class="h-hi mt-2 text-[1.7rem]">{s.name}</div><p class="mt-2 text-[var(--muted)]">{s.blurb}</p></a>; })}
    </div>
  </section>
</Base>
