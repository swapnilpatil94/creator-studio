 "plan": [
  {
   "id": "m01",
   "text": "तुम जानते हो, तीनों लोकों के देवता हारे तो दुर्गा बनीं कैसे?",
   "intent": "hook",
   "params": {
    "exaggeration": 0.7
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.35,
   "seed": 619,
   "words": 12,
   "warn": null
  },
  {
   "id": "m02",
   "text": "सामने था महिषासुर — बहुरूपिया। कभी भैंसा, कभी कुछ और। हर रूप में पहले से ज़्यादा ख़तरनाक।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.25,
   "seed": 8537,
   "words": 17,
   "warn": null
  },
  {
   "id": "m03",
   "text": "इसलिए इंद्र का सिंहासन छिन गया। देवताओं को अपना ही स्वर्ग छोड़ना पड़ा।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.95,
   "seed": 97656,
   "words": 13,
   "warn": null
  },
  {
   "id": "m04",
   "text": "लेकिन तभी उनका क्रोध एक हो गया… और उस तेज से एक देवी प्रकट हुईं — बिना किसी माँ के।",
   "intent": "awe",
   "params": {
    "exaggeration": 0.72
   },
   "tempo": 1.0,
   "gain_db": 0.5,
   "pause_after": 0.45,
   "seed": 40689,
   "words": 20,
   "warn": null
  },
  {
   "id": "m05",
   "text": "विष्णु ने चक्र दिया। वायु ने धनुष-बाण। हिमालय ने सिंह। हर देवता का थोड़ा-थोड़ा हिस्सा।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.25,
   "seed": 36595,
   "words": 15,
   "warn": null
  },
  {
   "id": "m06",
   "text": "तब सिंह पर सवार होकर वो रणभूमि में उतरीं।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.2,
   "seed": 15166,
   "words": 9,
   "warn": null
  },
  {
   "id": "m07",
   "text": "महिषासुर रूप बदलता रहा… पर अब बचने की जगह नहीं थी।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.4,
   "seed": 60545,
   "words": 11,
   "warn": null
  },
  {
   "id": "m08a",
   "text": "और अंत में — त्रिशूल।",
   "intent": "punch",
   "params": {
    "exaggeration": 0.75
   },
   "tempo": 1.05,
   "gain_db": 1.5,
   "pause_after": 0.95,
   "seed": 19295,
   "words": 5,
   "warn": null
  },
  {
   "id": "m08b",
   "text": "भैंसे का सिर कटा… और भीतर से असुर निकला। देवी ने उसे भी ख़त्म किया। वो बनीं — महिषासुरमर्दिनी।",
   "intent": "punch",
   "params": {
    "exaggeration": 0.75
   },
   "tempo": 1.05,
   "gain_db": 1.5,
   "pause_after": 0.4,
   "seed": 97140,
   "words": 19,
   "warn": null
  },
  {
   "id": "m09",
   "text": "देवता अकेले हारे थे। साथ मिले, तो देवी बन गए।",
   "intent": "reflective",
   "params": {
    "exaggeration": 0.5
   },
   "tempo": 0.98,
