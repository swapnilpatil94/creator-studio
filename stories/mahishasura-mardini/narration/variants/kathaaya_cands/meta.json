 "plan": [
  {
   "id": "m01",
   "text": "तीनों लोकों के देवता हार गए थे… तुम जानते हो, महिषासुर को किसने रोका?",
   "intent": "hook",
   "params": {
    "exaggeration": 0.7
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.4,
   "seed": 619,
   "words": 14,
   "warn": null
  },
  {
   "id": "m02",
   "text": "वो बहुरूपिया था। कभी भैंसा, कभी कुछ और — हर रूप में पहले से ज़्यादा ख़तरनाक।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.25,
   "seed": 8537,
   "words": 16,
   "warn": null
  },
  {
   "id": "m03",
   "text": "इंद्र का सिंहासन छिन गया। देवताओं को अपना ही स्वर्ग छोड़ना पड़ा।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.2,
   "seed": 97656,
   "words": 12,
   "warn": null
  },
  {
   "id": "m04",
   "text": "तब उनका क्रोध एक हो गया… और उनके तेज से जन्म हुआ एक देवी का।",
   "intent": "awe",
   "params": {
    "exaggeration": 0.72
   },
   "tempo": 1.0,
   "gain_db": 0.5,
   "pause_after": 0.45,
   "seed": 40689,
   "words": 15,
   "warn": null
  },
  {
   "id": "m05",
   "text": "विष्णु ने चक्र दिया। वायु ने धनुष-बाण। हिमालय ने सवारी के लिए सिंह।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.25,
   "seed": 36595,
   "words": 13,
   "warn": null
  },
  {
   "id": "m06",
   "text": "देवी सिंह पर सवार होकर रणभूमि में उतरीं।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.2,
   "seed": 15166,
   "words": 8,
   "warn": null
  },
  {
   "id": "m07",
   "text": "महिषासुर रूप बदलता रहा… पर अब बचने की जगह नहीं थी।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.4,
   "seed": 60545,
   "words": 11,
   "warn": null
  },
  {
   "id": "m08",
   "text": "और अंत में — त्रिशूल। भैंसे का सिर कटा… और भीतर से असुर निकला। देवी ने उसे भी ख़त्म किया। वो बनीं — महिषासुरमर्दिनी।",
   "intent": "punch",
   "params": {
    "exaggeration": 0.75
   },
   "tempo": 1.05,
   "gain_db": 1.5,
   "pause_after": 0.4,
   "seed": 20368,
   "words": 24,
   "warn": null
  },
  {
   "id": "m09",
   "text": "सबकी शक्ति एक हो जाए, तो कोई असुर नहीं टिकता।",
   "intent": "reflective",
