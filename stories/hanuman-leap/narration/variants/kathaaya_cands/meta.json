 "plan": [
  {
   "id": "n01",
   "text": "सौ योजन का समुद्र। सामने बस अँधेरा… और लहरें।",
   "intent": "hook",
   "params": {
    "exaggeration": 0.7
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.4,
   "seed": 24813,
   "words": 9,
   "warn": null
  },
  {
   "id": "n02",
   "text": "वानर सेना रुक गई थी। कोई उस पार जाने की हिम्मत नहीं कर पा रहा था।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.25,
   "seed": 13035,
   "words": 16,
   "warn": null
  },
  {
   "id": "n03",
   "text": "और हनुमान… चुप बैठे थे। वो भूल चुके थे कि वो कौन हैं।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.4,
   "seed": 1818,
   "words": 13,
   "warn": null
  },
  {
   "id": "n04",
   "text": "तभी जाम्बवान ने कहा — तुम पवनपुत्र हो। तुम्हारे लिए ये समुद्र कुछ भी नहीं।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.2,
   "seed": 97897,
   "words": 15,
   "warn": null
  },
  {
   "id": "n05",
   "text": "बस उसी पल… सब बदल गया।",
   "intent": "punch",
   "params": {
    "exaggeration": 0.75
   },
   "tempo": 1.05,
   "gain_db": 1.5,
   "pause_after": 0.4,
   "seed": 53988,
   "words": 6,
   "warn": null
  },
  {
   "id": "n06",
   "text": "हनुमान बढ़ते गए। पर्वत काँप उठा। और फिर… एक छलाँग।",
   "intent": "tense",
   "params": {
    "exaggeration": 0.68
   },
   "tempo": 1.1,
   "gain_db": 1.0,
   "pause_after": 0.4,
   "seed": 2058,
   "words": 10,
   "warn": null
  },
  {
   "id": "n07",
   "text": "बीच में मैनाक पर्वत समुद्र से उठा, बोला — थोड़ा विश्राम कर लो। हनुमान ने सिर झुकाया… और आगे बढ़ गए।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.4,
   "seed": 56842,
   "words": 21,
   "warn": null
  },
  {
   "id": "n08",
   "text": "क्योंकि जिसे अपनी ताक़त याद आ जाए, उसे रुकना नहीं आता।",
   "intent": "narrate",
   "params": {
    "exaggeration": 0.6
   },
   "tempo": 1.08,
   "gain_db": 0.0,
   "pause_after": 0.25,
   "seed": 55290,
   "words": 11,
   "warn": null
  },
  {
   "id": "n09",
