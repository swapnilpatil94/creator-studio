  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "2",
   "mode": "reveal"
  }
 },
 {
  "id": "v003",
  "text": "जो अपनी आजीविका के लिए दूसरों को धोखा देता है, या उनका हक़ छीनता है",
