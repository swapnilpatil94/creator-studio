   "type": "painting",
   "ref": "2",
   "mode": "reveal"
  }
 },
 {
  "id": "v003",
  "text": "गरुड़ पुराण में भगवान विष्णु ने यही रहस्य पक्षीराज गरुड़ को बताया",
