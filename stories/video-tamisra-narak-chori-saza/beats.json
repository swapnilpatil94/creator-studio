  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "1",
   "mode": "reveal"
  }
 },
 {
  "id": "v002",
  "text": "यह प्रश्न हर मनुष्य के मन में कभी न कभी उठता है",
