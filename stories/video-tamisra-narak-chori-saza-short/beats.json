[
 {
  "id": "v001",
  "text": "जब आत्मा शरीर छोड़ती है, तो वह कहाँ जाती है?",
  "intent": "hook",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "1",
   "mode": "reveal"
  }
 },
 {
  "id": "v002",
  "text": "गरुड़ पुराण कहता है, हर कर्म का हिसाब होता है",
  "intent": "curious",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "2",
   "mode": "reveal"
  }
 },
 {
  "id": "v003",
  "text": "और जो दूसरों का धन चुराता है, उसके लिए एक विशेष लोक है",
  "intent": "tense",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "3",
   "mode": "reveal"
  }
 },
 {
  "id": "v004",
  "text": "नाम है तमिस्र नरक, अर्थात घोर अंधकार का लोक",
