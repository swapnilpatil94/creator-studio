  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "4",
   "mode": "reveal"
  }
 },
 {
  "id": "v005",
  "text": "पुराण कहते हैं, यमराज के दूत आत्मा को वहाँ ले जाते हैं",
  "intent": "narrate",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "5",
   "mode": "reveal"
  }
 },
 {
  "id": "v006",
  "text": "न दीया है वहाँ, न सूरज की किरण, केवल घोर अंधकार",
  "intent": "narrate",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "6",
   "mode": "reveal"
  }
 },
 {
  "id": "v007",
  "text": "वहाँ चोर को कोड़ों से दंड मिलता है",
