[
 {
  "id": "v001",
  "text": "शव पेड़ से उतरा, और राजा से सवाल पूछा।",
  "intent": "hook",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "1",
   "mode": "reveal"
  }
 },
 {
  "id": "v002",
  "text": "शर्त थी: जवाब जानकर चुप रहा, तो सिर फट जाएगा।",
  "intent": "curious",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "2",
   "mode": "reveal"
  }
 },
 {
  "id": "v003",
  "text": "और बोल पड़ा, तो शव वापस पेड़ पर उड़ जाएगा।",
  "intent": "curious",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "3",
   "mode": "reveal"
  }
 },
 {
  "id": "v004",
  "text": "वेताल पंचविंशति की लोककथा के अनुसार, एक योगी ने राजा से वचन लिया।",
  "intent": "narrate",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "4",
   "mode": "reveal"
  }
 },
 {
  "id": "v005",
  "text": "वचन था: श्मशान के पेड़ पर लटका शव, उसके पास लाना।",
  "intent": "narrate",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "5",
   "mode": "reveal"
  }
 },
 {
  "id": "v006",
  "text": "राजा गया, शव को कंधे पर उठाया, और चल पड़ा।",
  "intent": "tense",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "6",
   "mode": "reveal"
  }
 },
 {
  "id": "v007",
  "text": "तभी शव के भीतर बैठा वेताल हँस पड़ा।",
  "intent": "tense",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "7",
   "mode": "reveal"
  }
 },
 {
  "id": "v008",
  "text": "बोला, \"रास्ता लंबा है, एक कहानी सुनो।\"",
  "intent": "narrate",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "8",
   "mode": "reveal"
  }
 },
 {
  "id": "v009",
  "text": "हर कहानी के अंत में, वह एक पहेली छोड़ता था।",
  "intent": "curious",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "9",
   "mode": "reveal"
  }
 },
 {
  "id": "v010",
  "text": "जवाब जानते हो, तो बोलो।",
  "intent": "punch",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "10",
   "mode": "reveal"
  }
 },
 {
  "id": "v011",
  "text": "राजा मौन रहता, तो शाप, बोलता, तो शव उड़ जाता।",
  "intent": "tense",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "11",
   "mode": "reveal"
  }
 },
 {
  "id": "v012",
  "text": "राजा जवाब देता, और हर बार शव लौट जाता।",
  "intent": "tense",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "12",
   "mode": "reveal"
  }
 },
 {
  "id": "v013",
  "text": "राजा फिर श्मशान जाता, और फिर शव उतारता।",
  "intent": "narrate",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "13",
   "mode": "reveal"
  }
 },
 {
  "id": "v014",
  "text": "ऐसा पच्चीस बार हुआ। न थका, न डिगा।",
  "intent": "awe",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "14",
   "mode": "reveal"
  }
 },
 {
  "id": "v015",
  "text": "आख़िर वेताल ने राजा की हिम्मत क्यों परखी?",
  "intent": "curious",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "15",
   "mode": "reveal"
  }
 },
 {
  "id": "v016",
  "text": "पच्चीसवीं पहेली पर, राजा जवाब नहीं दे पाया।",
  "intent": "reveal",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "16",
   "mode": "reveal"
  }
 },
 {
  "id": "v017",
  "text": "तब वेताल ने बताया, योगी की असली चाल क्या थी।",
  "intent": "reveal",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "17",
   "mode": "reveal"
  }
 },
 {
  "id": "v018",
  "text": "योगी उसी राजा की बलि चढ़ाकर, सिद्धि पाना चाहता था।",
  "intent": "tense",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "18",
   "mode": "reveal"
  }
 },
 {
  "id": "v019",
  "text": "वेताल की चेतावनी से, राजा बच गया।",
  "intent": "awe",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "19",
   "mode": "reveal"
  }
 },
 {
  "id": "v020",
  "text": "कथा के अनुसार, उसने उलटे योगी की बलि चढ़ा दी।",
  "intent": "narrate",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "20",
   "mode": "reveal"
  }
 },
 {
  "id": "v021",
  "text": "यानी जिसने सबसे ज़्यादा सवाल पूछे, वही सबसे सच्चा साथी निकला।",
  "intent": "reflective",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "21",
   "mode": "reveal"
  }
 },
 {
  "id": "v022",
  "text": "आप होते तो, पहेली पर बोलते या चुप रहते?",
  "intent": "curious",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "22",
   "mode": "reveal"
  }
 },
 {
  "id": "v023",
  "text": "अगली कथा में, टीर ने अपना हाथ भेड़िये के मुँह में क्यों डाला?। फ़ॉलो कीजिए।",
  "intent": "reflective",
  "chapter": "ch1",
  "visual": {
   "type": "painting",
   "ref": "23",
   "mode": "reveal"
  }
 }
]